# Copy to .env at the repository root and fill in your own values.
# .env is gitignored; never commit real keys.

# Required for every LLM step (phases 0-3), via https://openrouter.ai
OPENROUTER_API_KEY=

# NCBI E-utilities (article download). The email is required by NCBI;
# the API key is optional and raises the rate limit.
NCBI_EMAIL=
NCBI_API_KEY=
